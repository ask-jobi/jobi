# 客户端配置，会被打包进前端文件
NEXT_PUBLIC_SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=https://hellojobi.com
# NEXT_PUBLIC_ENVIRONMENT=staging  # staging 环境设置此变量，production 不设置

# 服务端配置
SUPABASE_SECRET_KEY=<SUPABASE_SECRET_KEY>

# AI provider: direct DeepSeek API
DEEPSEEK_API_KEY=<DEEPSEEK_API_KEY>
DEEPSEEK_MODEL_ID=deepseek-v4-flash

# Stripe test/validation environment
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# Optional analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=<UMAMI_WEBSITE_ID>
NEXT_PUBLIC_UMAMI_SCRIPT_URL=<UMAMI_SCRIPT_URL>
